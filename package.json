{
  "name": "multi-upstream-gateway",
  "version": "5.0.3",
  "description": "本地多上游 AI 网关：单一 OpenAI / Anthropic 兼容入口，统一接入多个 AI 上游。源自 commandcode-proxy (MIT) v4.22.4 的语义化分化。",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wjf1/multi-upstream-gateway.git"
  },
  "homepage": "https://github.com/wjf1/multi-upstream-gateway",
  "bugs": {
    "url": "https://github.com/wjf1/multi-upstream-gateway/issues"
  },
  "author": {
    "name": "wjf1",
    "url": "https://github.com/wjf1"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "setup": "node scripts/setup.mjs",
    "build": "tsc",
    "start": "node dist/index.js",
    "build:exe": "npm run build && esbuild dist/index.js --bundle --platform=node --format=cjs --outfile=dist/bundle.cjs --external:fsevents",
    "build:win": "npm run build:exe && pkg dist/bundle.cjs --target node22-win-x64 --output dist/multi-upstream-gateway-v5.exe --compress GZip",
    "test": "vitest run",
    "pretest": "npm run build",
    "verify": "npm run build && npm test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test:coverage": "vitest run --coverage",
    "//pretest:coverage": "npm 的 pre 钩子只对同名脚本生效——test:coverage 不会自动跑 pretest，曾因此让 spawn dist 的用例跑到过期构建产物上（假红）。",
    "pretest:coverage": "npm run build"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "outputPath": "dist"
  },
  "keywords": [
    "commandcode",
    "proxy",
    "openai",
    "anthropic",
    "api-gateway",
    "multi-upstream",
    "ai-gateway",
    "freebuff"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.5.1",
    "@vitest/coverage-v8": "5.0.0",
    "@yao-pkg/pkg": "6.22.0",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "chokidar": "5.0.0",
    "fastify": "5.12.5",
    "undici": "7.29.1",
    "zod": "4.6.5"
  }
}
